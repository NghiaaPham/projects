# ===== Bắt buộc =====
NODE_ENV=production
# Chuỗi kết nối PostgreSQL (Supabase / Neon / Postgres riêng)
DATABASE_URL=
# Mật khẩu chủ shop đã băm: npm run hash-password -- "matkhau"
SHOP_PASSWORD_HASH=
# Chuỗi bí mật ký token, >= 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== Tuỳ chọn (giá trị mặc định ở bên phải) =====
# PORT=3000
# TRUST_PROXY=1                    # số proxy phía trước (Render/Nginx = 1)
# DB_SSL=true                      # false nếu Postgres chạy local không SSL
# DB_SSL_REJECT_UNAUTHORIZED=false # true nếu có CA chuẩn
# DB_POOL_MAX=5
# JWT_EXPIRES_IN=30d
# CORS_ORIGINS=                    # vd: https://shop.example.com,https://admin.example.com ; trống = chỉ cùng domain
# BODY_LIMIT=15mb                  # giới hạn dung lượng 1 đơn (có ảnh base64)
# LOGIN_RATE_WINDOW_MIN=15
# LOGIN_RATE_MAX=10                # số lần thử đăng nhập mỗi IP trong cửa sổ trên
# CLIENT_POLL_MS=15000             # chu kỳ app tự đồng bộ
# SHOP_PASSWORD=                   # chỉ dùng khi dev, thay cho SHOP_PASSWORD_HASH
